# MCP Framework - example environment configuration
# Copy to .env and fill in real values. NEVER commit a real .env.

# App
APP_NAME=MCP Framework
DEBUG=false

# Security - generate a strong random value for production, e.g.:
# python -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY=change-me-generate-a-strong-random-key

# Infrastructure
REDIS_URL=redis://localhost:6379/0
CONNECTORS_DIR=src/infrastructure/connectors

# Connector credentials (dummy placeholders - replace with real keys in .env)
OPENAI_API_KEY=sk-your-openai-key-here
STRIPE_API_KEY=sk_test_your-stripe-key-here
